# Copie este arquivo para ".env" (Termux/local) ou configure as mesmas
# variáveis no painel da Vercel (Project Settings → Environment Variables).

# Obrigatória: senha do painel /admin.html. Escolha algo forte.
ADMIN_PASSWORD=

# Recomendada: segredo usado pra assinar o cookie de sessão do admin.
# Gere algo aleatório, ex: openssl rand -hex 32
SESSION_SECRET=

# Opcional: se você preencher isso, a chave da Groq fica FIXA por aqui e
# o painel de admin não vai conseguir trocá-la (útil em produção na Vercel
# se você não quiser depender de KV). Deixe em branco pra poder configurar
# a chave pelo painel /admin.html normalmente.
GROQ_API_KEY=

# Opcional: token da Hugging Face (Inference Providers), pra habilitar os
# modelos "HF" no chat além dos da Groq. Pegue um token grátis em
# huggingface.co/settings/tokens (permissão "Make calls to Inference
# Providers" é suficiente). Assim como GROQ_API_KEY, se você preencher isso
# aqui o token fica FIXO e o painel de admin não deixa trocar por lá — deixe
# em branco pra configurar pelo painel normalmente. Aceita HF_TOKEN ou
# HUGGINGFACE_API_KEY (qualquer um dos dois nomes funciona).
HF_TOKEN=

# Opcional, só pra Vercel: se você conectar um Vercel KV (ou um Upstash
# Redis) ao projeto, essas variáveis são preenchidas automaticamente e as
# chaves salvas pelo painel de admin (Groq e Hugging Face) passam a persistir
# de verdade entre deploys/cold starts. Sem isso, na Vercel a chave salva
# pelo painel fica só em /tmp (temporária).
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Porta do servidor local (Termux/VPS). Não é usada na Vercel.
PORT=3000
